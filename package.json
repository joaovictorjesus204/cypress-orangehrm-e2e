{
  "name": "cypress-orangehrm-e2e",
  "version": "1.0.0",
  "description": "Automação E2E e de API com Cypress + TypeScript no OrangeHRM, sistema de RH usado por empresas",
  "author": "João Victor de Jesus",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "cypress run",
    "test:ui": "cypress run --spec \"cypress/e2e/ui/**/*.cy.ts\"",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.ts\"",
    "test:headed": "cypress run --headed --browser chrome",
    "cy:open": "cypress open",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@types/node": "^20.11.0",
    "cypress": "^14.0.0",
    "cypress-mochawesome-reporter": "^3.8.2",
    "typescript": "^5.4.0"
  }
}
